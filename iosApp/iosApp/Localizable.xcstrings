    "%@ %@" : {
      "comment" : "A month name and year, e.g. \"January 2024\"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@,  %@  %d, %@" : {
      "comment" : "A label displaying a date in the format of \"Sunday,  Apr  26, 2026\"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@,  %2$@  %3$d, %4$@"
          }
        }
      }
    },
    "%d" : {
      "comment" : "A day of the month, in the range 1-31.",
      "isCommentAutoGenerated" : true
    },
    "%d%%" : {
      "comment" : "A label that shows the progress of a production. The argument is the progress percentage.",
      "isCommentAutoGenerated" : true
    },
